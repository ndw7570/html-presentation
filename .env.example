# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.

# 서버에서 열릴 포트
HOST_PORT=4300

# 파일 한 개 크기 한도
MAX_UPLOAD=50mb

# 첫 계정. 계정이 하나도 없을 때만 쓰인다.
# 한 번 만들어진 뒤에는 이 값을 바꿔도 아무 일도 일어나지 않는다.
# 계정이 생기면 이 두 줄은 지우는 편이 낫다.
ADMIN_USER=
ADMIN_PASSWORD=

# HTTPS(nginx 등) 뒤에 둘 때 1 로 켠다.
SECURE_COOKIE=0

# 세션 서명 열쇠. 비워 두면 서버가 만들어 data/session-secret 에 둔다.
# 서버를 여러 대로 늘릴 때만 직접 지정하면 된다.
SESSION_SECRET=
